{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],

    "module": "ESNext",
    "moduleDetection": "force",

    "noEmit": true,

    "strict": false,

    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "scripts/types/shiguang-bridge.d.ts",
    "resources/**/*.js"
  ]
}